# Configuração do servidor da Hostinger (LiteSpeed/Apache) para a Vivale Store.
# O GitHub Pages ignora este arquivo.

Options -Indexes
DirectoryIndex index.html

# Painel do vendedor: o servidor pede usuário e senha antes de entregar a página.
# O arquivo de senhas fica fora da public_html e fora do Git (criado pelo hPanel).
<Files "admin.html">
  AuthType Basic
  AuthName "Area do Vendedor"
  AuthUserFile /home/u151095779/domains/vivalestore.com.br/.htpasswd
  Require valid-user
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redireciona todo acesso sem criptografia para HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Bloqueia arquivos ocultos (.git, .gitignore...), exceto a validação do certificado SSL
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Bloqueia o que é só de desenvolvimento e não faz parte da loja
  RewriteRule ^(tests|ferramentas|node_modules)(/|$) - [F,L]
  RewriteRule ^package(-lock)?\.json$ - [F,L]
</IfModule>

# Tempo de cache no navegador da cliente
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# Cabeçalhos básicos de segurança
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
