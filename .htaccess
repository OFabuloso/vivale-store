# Configuração do servidor da Hostinger (LiteSpeed/Apache) para a Vivale Store.
# O GitHub Pages ignora este arquivo.

Options -Indexes
DirectoryIndex index.html

# Painel do vendedor: o acesso é conferido pelo login do próprio painel (api/sessao.php),
# com senha por pessoa, bloqueio após erros e permissões de dono e funcionário.
# A senha extra do servidor (.htpasswd) foi retirada em 2026-11-26.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Endereço único: www.vivalestore.com.br vai para vivalestore.com.br (já em HTTPS).
  # Assim o Google não vê duas lojas iguais e o login do painel vale num endereço só.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Redireciona todo acesso sem criptografia para HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Bloqueia arquivos ocultos (.git, .gitignore...), exceto a validação do certificado SSL
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Bloqueia o que é só de desenvolvimento e não faz parte da loja
  RewriteRule ^(tests|tests-api|ferramentas|node_modules|docker)(/|$) - [F,L]
  RewriteRule ^(package(-lock)?\.json|docker-compose\.yml)$ - [F,L]

  # Peças internas do backend: só são usadas pelos endpoints, nunca acessadas direto
  RewriteRule ^api/(nucleo|sql)(/|$) - [F,L]
  RewriteRule ^api/config\.exemplo\.php$ - [F,L]

  # Fotos enviadas pelo painel: ficam fora da public_html e são entregues pelo api/foto.php
  RewriteRule ^fotos/([a-f0-9]{32}(?:\.jpg|-(?:400|600)\.webp))$ api/foto.php?arquivo=$1 [L]
</IfModule>

# Tempo de cache no navegador da cliente
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# CSS e JavaScript: o navegador confere a cada visita se mudou (responde 304 quando não mudou).
# Assim, depois de uma publicação, ninguém fica com versões misturadas. A Hostinger entrega
# o JS como application/x-javascript, por isso a regra é pelo nome do arquivo e não pelo tipo.
<FilesMatch "\.(js|css)$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
    Header unset Expires
  </IfModule>
</FilesMatch>

# Cabeçalhos básicos de segurança
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
